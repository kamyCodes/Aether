# --- Aether environment configuration ---
# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Required for authenticated OmniRoute requests. The server fails with a
# clear startup message when this is missing (unauthenticated requests are
# rejected by most gateway deployments).
OMNIROUTE_API_KEY=

# OmniRoute gateway base URL (default shown). Override only if your gateway
# listens elsewhere.
# OMNIROUTE_BASE_URL=http://localhost:20128/v1

# PostgreSQL for the persistence layer (or use DATABASE_URL). Defaults:
# host localhost, port 5432, user postgres, database aether_db.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=aether_db

# Aether backend port (default 5175). The Vite dev server proxies /api and
# /ws to this port.
# PORT=5175
