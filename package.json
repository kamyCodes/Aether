{
  "name": "aether",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "AI coding IDE and autonomous agent",
  "main": "electron/dist/main.cjs",
  "scripts": {
    "package:win": "node scripts/build-windows-installer.mjs",
    "package:win:dir": "node scripts/build-windows-installer.mjs --dir",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p server/tsconfig.json",
    "build:web": "vite build",
    "start": "npm run build && node dist-server/index.js",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit && npm run lint:css",
    "test": "tsx --test tests/*.test.ts",
    "lint:css": "node scripts/lint-artifact-tokens.mjs src/styles.css",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:gate": "node scripts/audit-gate.mjs",
    "audit:port-test": "node --import tsx scripts/port-probe.mjs",
    "audit:isolation": "node --import tsx scripts/isolation-probe.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^4.0.1",
    "diff": "^7.0.0",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "framer-motion": "^13.2.0",
    "isomorphic-git": "^1.27.1",
    "lucide-react": "^0.469.0",
    "minisearch": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.9",
    "node-pty": "^1.0.0",
    "picomatch": "^4.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "vscode-icons-js": "^11.6.1",
    "ws": "^8.18.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/diff": "^7.0.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "@vscode/ripgrep": "^1.18.0",
    "concurrently": "^9.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
